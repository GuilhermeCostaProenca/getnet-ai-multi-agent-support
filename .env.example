# Anthropic (CON-02)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# one retry on connection/timeout/5xx errors; empty disables
FALLBACK_MODEL=claude-sonnet-5-5
LLM_EFFORT=low

# Security — long random string, never commit the real one
JWT_SECRET=
JWT_ISSUER=getnet-support
ENABLE_DEV_TOKENS=false
RATE_LIMIT_PER_MINUTE=30

# Knowledge / orchestration
DATABASE_PATH=data/getnet.db
AUTO_INGEST=true
RERANK_ENABLED=true

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_ENDPOINT=
