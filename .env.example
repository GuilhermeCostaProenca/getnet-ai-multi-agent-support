# Required
OPENAI_API_KEY=sk-your-key-here
# Long random string used to sign/verify JWTs, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Auth
JWT_ISSUER=getnet-support
JWT_TTL_MINUTES=60
ENABLE_DEV_TOKENS=false        # true exposes POST /v1/auth/dev-token (demo/testing only)
RATE_LIMIT_PER_MINUTE=30

# Models
# openai (default) | anthropic: Claude does planning/agents/tools/web search; retrieval switches to BM25 and the
# planner's `unsafe` intent replaces the moderation endpoint (no OpenAI key or credit needed)
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
CHAT_MODEL=gpt-5.4-mini
# one retry on connection/timeout/5xx errors of CHAT_MODEL; empty disables
FALLBACK_CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
MODERATION_MODEL=omni-moderation-latest

# State and RAG
DATABASE_PATH=./data/app.db
CHROMA_PATH=./data/chroma
AUTO_INGEST=true
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.30

# Orchestration
PLANNER_MIN_CONFIDENCE=0.55
MAX_CLARIFICATIONS=1
HISTORY_WINDOW=10
MODERATION_ENABLED=true
LOG_LEVEL=INFO
